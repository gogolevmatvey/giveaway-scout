[Unit]
Description=Giveaway Scout installation statistics
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/giveaway-scout-telemetry/giveaway-scout-telemetry
StateDirectory=giveaway-scout-telemetry
StateDirectoryMode=0700
LoadCredential=installation-salt:/etc/giveaway-scout-telemetry/salt
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077
MemoryMax=128M
CPUQuota=25%
TasksMax=32

[Install]
WantedBy=multi-user.target
