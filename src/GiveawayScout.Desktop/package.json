{
  "name": "giveaway-scout-desktop",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.node.json && node ./node_modules/vite/bin/vite.js build",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:ui:browser": "node --test --test-concurrency=1 ./tests/ui/browser.wdio.mjs",
    "build:ui:native": "node ./scripts/build-native-ui.mjs",
    "check:ui:native": "node ./scripts/build-native-ui.mjs --check",
    "test:ui:native": "node ./scripts/run-native-ui.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "tauri": "node ./scripts/tauri.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tauri-apps/api": "2.12.2",
    "i18next": "26.4.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "webdriverio": "10.1.0"
  }
}
